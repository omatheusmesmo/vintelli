<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.omatheusmesmo</groupId>
        <artifactId>vintelli</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vintelli-local</artifactId>

    <description>
        Process runner, build tool detection and filesystem access for the standalone provider. Depends on the api ports only.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.omatheusmesmo</groupId>
            <artifactId>vintelli-api</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>dev.omatheusmesmo:vintelli-jsonrpc</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-acp</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-lsp</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-idea</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-tui</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-core</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-core-deployment</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-app</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
