{
  "origin": {
    "release": "IntelliJ IDEA Ultimate 2026.2.3 (build IU-262.10968.63)",
    "chrome": "ui and colors excerpt in dark-theme-source.json, from the platform file themes/expUI/expUI_dark.theme.json",
    "editor": "dark-scheme-source.xml, the New UI Dark editor scheme themes/expUI/expUI_darkScheme.xml; the selection color is inherited from the Darcula editor parent inside darcula-scheme-source.xml",
