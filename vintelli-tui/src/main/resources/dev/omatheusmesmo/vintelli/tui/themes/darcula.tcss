/*
 * Vintelli shell theme "darcula": the classic Darcula UI chrome plus the
 * classic Darcula editor palette.
 *
 * Source and release: IntelliJ IDEA Ultimate 2026.2.3 (build IU-262.10968.63).
 * Chrome values are mechanical translations of the `ui` section of the
 * platform file themes/darcula.theme.json; editor values are taken from the
 * platform Darcula editor color scheme (the Darcula scheme inside
 * DefaultColorSchemesManager.xml of the same build). Source keys are cited on
 * every variable against verbatim excerpts of those files; the packaged
 * `theme-source-*` test resolves both. Two roles reuse a value chosen from a
 * neighbouring official element rather than one named for that exact role;
 * those lines say "chosen from". No value is hand picked.
 *
 * The chrome palette styles the shell UI; the editor palette ($editor-*)
 * only styles editor text, keywords, strings and comments and never leaks
 * into the UI chrome.
 *
 * Color depth: the hex values below are the authored palette of the theme and
 * the source of the index table in docs/themes.md. A session that does not run
 * with truecolor (property `vintelli.tui.color-level`, see docs/themes.md) gets
 * every hex value of this sheet replaced by the nearest fixed 256 color index
 * before the stylesheet is parsed, so the indices of docs/themes.md are what such a
 * terminal renders (issue #139).
 */
$panel            : #3C3F41;       /* ui["*"].background */
$chrome-fg        : #BBBBBB;       /* ui["*"].foreground */
$chrome-fg-strong : #DEDEDE;       /* chosen from: ui["*"].selectionForeground */
$muted            : #787878;       /* ui["Component"].infoForeground */
$soft             : #808080;       /* ui["SearchEverywhere"].Advertiser.foreground */
$selection-bg     : #2F65CA;       /* ui["*"].selectionBackground (os.default) */
$selection-fg     : #DEDEDE;       /* ui["*"].selectionForeground */
$tab-selected-bg  : #365880;       /* chosen from: ui["Button"].default.startBackground */
$tab-selected-fg  : #DEDEDE;       /* chosen from: ui["*"].selectionForeground */
$border           : #515151;       /* ui["MenuBar"].borderColor */
$focus-border     : #466D94;       /* ui["Component"].focusedBorderColor */
$editor-border    : #515151;       /* ui["MenuBar"].borderColor */

$editor-bg        : #2B2B2B;       /* editor scheme TEXT background */
$editor-fg        : #A9B7C6;       /* editor scheme TEXT foreground */
$editor-keyword   : #CC7832;       /* editor scheme DEFAULT_KEYWORD */
$editor-string    : #6A8759;       /* editor scheme DEFAULT_STRING */
$editor-comment   : #808080;       /* editor scheme DEFAULT_LINE_COMMENT */
$editor-number    : #6897BB;       /* editor scheme DEFAULT_NUMBER */
$editor-constant  : #9876AA;       /* editor scheme DEFAULT_CONSTANT */
$editor-selection : #214283;       /* editor scheme SELECTION_BACKGROUND */
$editor-sel-fg    : #A9B7C6;       /* editor scheme TEXT foreground */
$editor-caret-row : #323232;       /* editor scheme CARET_ROW_COLOR */

#shell {
  background: $panel;
  color: $chrome-fg;
}

#main-toolbar {
  background: $panel;
  color: $chrome-fg;
}

.toolbar-widget {
  color: $chrome-fg;
}

.menu-entry {
  color: $chrome-fg;
}

.menu-entry-active {
  color: $selection-fg;
  background: $selection-bg;
}

ToolTabBarElement {
  background: $editor-bg;
}

ToolTabBarElement-tab {
  color: $soft;
}

ToolTabBarElement-tab:selected {
  color: $chrome-fg-strong;
  text-style: bold;
}

ToolTabBarElement-shortcut {
  color: $muted;
}

ToolTabBarElement-underline {
  color: $focus-border;
}

ToolTabBarElement-overflow {
  color: $soft;
}

ToolStripElement {
  background: $panel;
}

ToolStripElement-icon {
  color: $soft;
}

ToolStripElement-icon:selected {
  color: $tab-selected-fg;
  background: $tab-selected-bg;
}

TabsElement-tab {
  color: $soft;
}

TabsElement-tab:selected {
  color: $tab-selected-fg;
  background: $tab-selected-bg;
  text-style: bold;
}

TabsElement-divider {
  color: $soft;
}

#project-panel {
  background: $panel;
  color: $chrome-fg;
}

ListElement-item {
  color: $chrome-fg;
}

ListElement-item:selected {
  color: $selection-fg;
  background: $selection-bg;
}

ListElement-scrollbar-thumb {
  color: $muted;
}

ListElement-scrollbar-track {
  color: $editor-bg;
}

#editor-panel {
  background: $editor-bg;
  color: $editor-fg;
}

#editor-content {
  color: $editor-fg;
}

.editor-start-text {
  color: $editor-fg;
}

.editor-start-hint {
  color: $muted;
}

#editor-tabs {
  background: $editor-bg;
}

EditorTabBarElement-tab {
  color: $soft;
}

EditorTabBarElement-tab:selected {
  color: $chrome-fg-strong;
}

EditorTabBarElement-underline {
  color: $focus-border;
}

EditorTabBarElement-marker {
  color: $focus-border;
}

EditorTabBarElement-overflow {
  color: $soft;
}

.editor-line-number {
  color: $muted;
}

.editor-line-number-current {
  color: $editor-fg;
}

.editor-breakpoint-verified {
  color: $editor-string;
}

.editor-breakpoint-pending {
  color: $editor-number;
}

.editor-breakpoint-rejected {
  color: $editor-keyword;
}

.editor-caret {
  text-style: reversed;
}

#editor-find {
  color: $editor-fg;
  background: $editor-bg;
}

.editor-find-match {
  background: $editor-selection;
}

.editor-find-current {
  background: $selection-bg;
  text-style: bold;
}

.editor-find-count {
  color: $muted;
}

.editor-push-highlight {
  color: $editor-keyword;
  text-style: bold;
}

.editor-diff-title {
  color: $editor-keyword;
  text-style: bold;
}

.editor-diff-added {
  color: $chrome-fg-strong;
  text-style: bold;
}

.editor-diff-removed {
  color: $muted;
}

.editor-diff-marker {
  color: $muted;
}

.editor-diff-context {
  color: $editor-fg;
}

.tool-window {
  color: $chrome-fg;
}

.tool-window-title {
  color: $chrome-fg-strong;
}

.pane-header {
  color: $soft;
}

.pane-header-focused {
  color: $chrome-fg-strong;
  text-style: bold;
}

.pane-marker {
  color: $focus-border;
}

#status-bar {
  background: $panel;
  color: $chrome-fg-strong;
}

/* Islands: the frame is $panel and every pane island is $editor-bg. A gap cell
   is a half block in the island tone over the frame tone (.pane-gap), a corner
   is a quarter block in the frame tone over the island tone (.pane-corner). */
#project-pane {
  background: $panel;
}

#bottom-stripe {
  background: $panel;
}

#right-tool-stripe {
  background: $panel;
}

.pane-gap {
  color: $editor-bg;
  background: $panel;
}

.pane-corner {
  color: $panel;
  background: $editor-bg;
}

.pane-header-rule {
  color: $panel;
}

ToolTabBarElement-header-rule {
  color: $panel;
}

EditorTabBarElement-header-rule {
  color: $panel;
}
