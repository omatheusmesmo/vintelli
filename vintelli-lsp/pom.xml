<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.omatheusmesmo</groupId>
        <artifactId>vintelli</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vintelli-lsp</artifactId>

    <description>
        Generic LSP client over LSP4J plus server profiles (health, command, initialization options), implementing the diagnostics and call hierarchy capability ports. Native reflection registration lives in the `vintelli-core` deployment build step.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.omatheusmesmo</groupId>
            <artifactId>vintelli-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
            <version>${lsp4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>share-test-fixtures</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>dev.omatheusmesmo:vintelli-local</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-idea</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-tui</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-core</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-core-deployment</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-app</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-jsonrpc</exclude>
                                        <exclude>dev.omatheusmesmo:vintelli-acp</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
